# Todo es opcional: cada valor también se edita desde el panel (/admin → Ajustes), y lo guardado
# en el panel tiene prioridad sobre este archivo. Copiar a .env (desarrollo) o /etc/tiklive/env
# (producción, permisos 600).

# Único ajuste que no está en el panel: dónde se guardan los valores editados desde el panel.
CONFIG_PATH=./data/config.json

PORT=3000
HOST=0.0.0.0
TIKTOK_USERNAME=
DB_PATH=./data/app.db
ASSETS_DIR=./data/assets
# Carpeta de los overlays compilados (por defecto packages/overlays/dist).
OVERLAYS_DIR=
# Carpeta del panel compilado (por defecto apps/dashboard/dist/dashboard/browser). Solo variable de entorno.
DASHBOARD_DIR=
# Clave de solo lectura para overlays (?key=), mínimo 16 caracteres. Si falta, se genera sola.
OVERLAY_KEY=
# Hash argon2id de la contraseña del panel. Si falta, el primer inicio pide crearla con un código
# que aparece en la consola del servidor.
ADMIN_PASSWORD_HASH=
# Temporal: por defecto el panel NO pide login y la sesión no expira. Pon false para reactivarlo.
AUTH_DISABLED=true
LOG_LEVEL=info
# true = ensayo con el simulador en lugar del conector real
SIMULATE=false
TIKTOK_SIGN_API_KEY=

# Clave gratuita de la API oficial de Freesound (https://freesound.org/apiv2/apply) para buscar
# sonidos ahí además de en MyInstants. Vacía = solo MyInstants.
FREESOUND_API_KEY=

# Opcional. Vacío = se lee www.myinstants.com directamente. Si se define, se usa en su lugar una API
# comunitaria (no oficial) alojada por ti, p. ej. https://mi-instancia.example
MYINSTANTS_API_URL=

# Acción webhook: hosts a los que se puede llamar (separados por comas). Vacío = webhooks desactivados.
WEBHOOK_ALLOWED_HOSTS=
# Subconjunto de los anteriores que puede resolver a direcciones privadas o de la LAN (p. ej. 192.168.1.50).
WEBHOOK_PRIVATE_HOSTS=

# Graba cada evento crudo de un live real en este archivo JSONL (se reproduce con `npm run simulate -- replay`).
# Contiene los usuarios y comentarios reales de tu audiencia: no lo subas a git.
RECORD_PATH=

# Carpeta de respaldos: base de datos a diario (14 días) y assets cada semana (4 copias).
BACKUP_DIR=./data/backups
