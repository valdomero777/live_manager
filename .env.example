# Todo es opcional: cada valor también se edita desde el panel (/admin → Ajustes), y lo guardado
# en el panel tiene prioridad sobre este archivo. Copiar a .env (desarrollo) o /etc/tiklive/env
# (producción, permisos 600).

# Único ajuste que no está en el panel: dónde se guardan los valores editados desde el panel.
CONFIG_PATH=./data/config.json

PORT=3000
HOST=0.0.0.0
TIKTOK_USERNAME=
DB_PATH=./data/app.db
ASSETS_DIR=./data/assets
# Clave de solo lectura para overlays (?key=), mínimo 16 caracteres. Si falta, se genera sola.
OVERLAY_KEY=
# Hash argon2id de la contraseña del panel. Si falta, el primer inicio pide crearla con un código
# que aparece en la consola del servidor.
ADMIN_PASSWORD_HASH=
LOG_LEVEL=info
# true = ensayo con el simulador en lugar del conector real
SIMULATE=false
TIKTOK_SIGN_API_KEY=

# API comunitaria (no oficial) usada para buscar sonidos de MyInstants. Solo cambiar si se aloja otra.
MYINSTANTS_API_URL=https://myinstants-api.vercel.app

# API comunitaria (no oficial) usada para buscar sonidos de MyInstants. Solo cambiar si se aloja otra.
MYINSTANTS_API_URL=https://myinstants-api.vercel.app

# Acción webhook: hosts a los que se puede llamar (separados por comas). Vacío = webhooks desactivados.
WEBHOOK_ALLOWED_HOSTS=
# Subconjunto de los anteriores que puede resolver a direcciones privadas o de la LAN (p. ej. 192.168.1.50).
WEBHOOK_PRIVATE_HOSTS=
